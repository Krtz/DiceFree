# Normalize text
* text=auto

# Unity YAML/text assets should remain diffable
*.cs text
*.shader text
*.cginc text
*.compute text
*.json text
*.xml text
*.yaml text
*.yml text
*.asmdef text
*.asmref text
*.meta text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.asset text

# Large/binary art and media via Git LFS
*.blend filter=lfs diff=lfs merge=lfs -text
